{
  "mcpServers": {
    "github": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-github"
      ],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_PERSONAL_ACCESS_TOKEN}"
      },
      "timeoutSeconds": 60,
      "disabledTools": [
        "delete_branch",
        "delete_repository",
        "force_push"
      ]
    }
  }
}
